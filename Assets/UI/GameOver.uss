.game-over-screen {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.8);
    justify-content: center;
    align-items: center;
}

.game-over-title {
    color: white;
    font-size: 60px;
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.menu-button {
    background-color: #0078D4;
    color: white;
    font-size: 24px;
    padding: 10px 40px;
    border-radius: 5px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    width: 300px;
}

.menu-button:hover {
    background-color: #005A9E;
}

.menu-button:active {
    background-color: #004578;
}
